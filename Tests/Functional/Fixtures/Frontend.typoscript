# The test helper writes a root template with `clear = 3`, which also drops the TypoScript
# the site set contributes. Importing the set's setup here puts it back.
@import 'EXT:vgwort/Configuration/Sets/vgwort/setup.typoscript'

page = PAGE

# The Fluid partial is rendered the way the README describes, next to the TypoScript output
# of the site set, so both paths are covered.
page.20 = FLUIDTEMPLATE
page.20 {
  template = TEXT
  template.value (
    <f:render partial="VgwortTracking" arguments="{vgwort_pixel: data.tx_vgwort_pixel, vgwort_ignore: data.tx_vgwort_ignore, vgwort_domain: site.settings.vgwort.domain}"/>
  )
  partialRootPaths.5 = EXT:vgwort/Resources/Private/Partials
  dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\SiteProcessor
  stdWrap.wrap = <!--partial-->|<!--/partial-->
}
